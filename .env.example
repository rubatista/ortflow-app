# Chave de API da Anthropic (console.anthropic.com), usada pelo gerador de horários por IA.
ANTHROPIC_API_KEY=

# Segredo usado para cifrar o cookie de sessão (login). Gera um valor aleatório com pelo menos 32 caracteres,
# por exemplo: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Base de dados (Turso/libSQL). Deixa ambos vazios para usar um ficheiro SQLite local (bom para dev,
# NÃO funciona em serverless como a Vercel — o disco não persiste). Para produção, cria uma base de
# dados grátis em https://turso.tech (turso db create + turso db tokens create) e preenche os dois.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Caminho do ficheiro SQLite local, só usado quando TURSO_DATABASE_URL está vazio. Opcional — por
# omissão usa .data/ortflow.sqlite3
DATABASE_PATH=
